{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signalwatch",
  "version": "0.1.0",
  "identifier": "au.com.signalwatch.desktop",
  "build": {
    "frontendDist": "../../signalwatch/dist/public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @workspace/signalwatch run dev",
    "beforeBuildCommand": "pnpm --filter @workspace/signalwatch run build"
  },
  "app": {
    "windows": [
      {
        "title": "Signalwatch",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#070a10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:5000 https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Signalwatch",
    "shortDescription": "Signalwatch global layer monitoring",
    "longDescription": "Signalwatch desktop client: public cameras, civic incidents, natural hazards and maritime positions from free, openly licensed sources.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
